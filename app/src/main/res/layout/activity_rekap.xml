<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matcha_cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊"
        android:textSize="36sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Rekap &amp; Closing"
        android:textColor="@color/matcha_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPilihTanggal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/matcha_field"
        android:text="Pilih Tanggal"
        android:textAllCaps="false"
        android:textColor="@color/matcha_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLaporan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@color/matcha_field"
        android:padding="16dp"
        android:text="Silakan pilih tanggal untuk melihat rekap penjualan."
        android:textColor="@color/matcha_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnClosing"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/matcha_green"
        android:text="Lakukan Closing"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
